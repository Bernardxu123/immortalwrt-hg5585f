# ---------------------------------------------------------------------------
# 分流层 B：OpenClash
#
# 由 gen-config.sh 按 PROXY=openclash 追加到 kconfig 链的最后一步。
#
# 与 Passwall 的差别（决定选哪个之前先看这里）：
#   * OpenClash 的 DEPENDS 里有 +ruby +ruby-yaml，Ruby 是源码编译，
#     单这一项约 +15~25 分钟；Passwall 不需要 Ruby。
#   * OpenClash 运行时要靠 Ruby 生成配置，512 MiB 内存下 RSS 明显高于 Passwall。
#   * 优点是 Clash 订阅（机场常见格式）原生可用，不用转换。
#   * 内核（mihomo）是运行时下载的，不参与编译。
#
# 如果主要用机场的 Clash 订阅且能接受内存占用，选这个；
# 否则选 passwall（默认）。
# ---------------------------------------------------------------------------

CONFIG_PACKAGE_luci-app-openclash=y

# 与 Passwall 互斥
# CONFIG_PACKAGE_luci-app-passwall is not set
