# ---------------------------------------------------------------------------
# 分流层 A：Passwall（512 MiB RAM 首选）
#
# 由 gen-config.sh 按 PROXY=passwall 追加到 kconfig 链的最后一步（在 build 层之后），
# 所以这里的每一项都能覆盖前面的层。
#
# 依赖全部来自 ImmortalWrt 自带 feeds，不需要额外 feed：
#   luci-app-passwall        immortalwrt/luci/applications/luci-app-passwall
#   xray-core / sing-box /   immortalwrt/packages/net/
#   hysteria / geoview /
#   v2ray-plugin / simple-obfs
#
# 为什么不开 Shadowsocks-Rust：它会把 Rust 工具链拉进构建（rust/host 现编，
# ccache 覆盖不到），单这一项就能多烧 30 分钟以上。而实际节点是
# VLESS/Reality/Hy2，用不到 SS-Rust。
# ---------------------------------------------------------------------------

CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geoview=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin=y

# 明确关掉会拖长构建或不需要的
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadow_TLS is not set

# 与 OpenClash 互斥
# CONFIG_PACKAGE_luci-app-openclash is not set
