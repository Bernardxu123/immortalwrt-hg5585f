# ---------------------------------------------------------------------------
# 分流层 C：dae（eBPF 透明代理，单内核极简形态）
#
# 由 gen-config.sh 按 PROXY=dae 追加到 kconfig 链的最后一步（在 build 层之后），
# 所以这里的每一项都能覆盖前面的层。
#
# 为什么是"只保留一种代理"：
#   dae 全程跑在内核 eBPF 里，直连流量不进用户态，只有被代理的流才进 dae 进程。
#   它自带 DNS/路由/订阅/分组全套能力，不需要 passwall/openclash 那层调度框架，
#   也不需要 sing-box/xray 等第二个内核。镜像里只有 1 个 dae 二进制。
#
# 硬前提（缺一不可，dae 起不来）：
#   1) 内核 >= 5.17（bpf_loop，启动时硬检查，低于它直接 FATAL）
#      —— ponwrt 是 6.18，满足。QWRT 的 5.4 BSP 内核【不满足】，故本层只对 ponwrt 有效。
#   2) 内核 BTF（/sys/kernel/btf/vmlinux）：DEBUG_INFO + DEBUG_INFO_BTF
#   3) TC eBPF：NET_CLS_BPF / NET_CLS_ACT / NET_SCH_INGRESS
#   4) cgroup2（socket hook）：CGROUPS + CGROUP_BPF
#
# ⚠️ 本层只负责【开启】类符号。有两个符号本层管不了，必须在核心里改：
#      - CONFIG_DEBUG_INFO_DWARF4 / DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT
#        原因：config/Config-kernel.in 里没有 KERNEL_DEBUG_INFO_DWARF* 符号，
#              buildroot 层根本写不出来（写了会被 defconfig 当未定义符号丢掉）。
#        见 target/linux/airoha/an7581/config-6.18。
#      - CONFIG_DEBUG_INFO_REDUCED 的【关闭】虽然可以写在这里（有 KERNEL_ 前缀，
#        见下方），但内核层自己已经是 not set —— 是 buildroot 的 an7581.config:310
#        把它翻回 y 的，所以这里覆盖掉即可。
#
# 构建代价（务必知情）：
#   * 开 BTF 后内核要生成 DWARF 再转 BTF，内核编译时间与中间产物显著变大。
#   * dae 的 eBPF 字节码由【宿主机 clang】编译（BPF_TOOLCHAIN_HOST=y），
#     dae 官方要求 clang >= 15，Ubuntu 24.04 runner 是 18，满足。
#   * PKG_BUILD_DEPENDS 里有 golang/host 与 bpf-headers，两者都会拉长首次构建。
# ---------------------------------------------------------------------------

# ---- 1. 内核 BTF（dae 的硬前提）----
# 注意顺序语义：kconfig.pl 的 `+` 是后者无条件覆盖前者，所以
# “先写 y 再写 not set”的顺序不重要，重要的是本层位于链条最后。
CONFIG_KERNEL_DEBUG_INFO=y
# an7581.config:310 把 REDUCED 打开了；BTF 依赖 !REDUCED，必须关掉它
# （config/Config-kernel.in: KERNEL_DEBUG_INFO_BTF depends on
#   KERNEL_DEBUG_INFO && !KERNEL_DEBUG_INFO_REDUCED）
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y

# ---- 2. eBPF / TC / cgroup（dae 数据面）----
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_BPF_STREAM_PARSER=y
CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_XDP_SOCKETS=y
# netkit（>=6.7 才有；6.18 满足。dae 会优先用它，不支持时回退 veth）
CONFIG_KERNEL_NETKIT=y

# TC 分类器/动作没有 CONFIG_KERNEL_* 前缀符号，只能靠装 kmod 包注入
# （package-metadata.pl 会生成 .config.override），所以必须同时装下面两个包。
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y
# dae 的 dae0/dae0peer 设备对：netkit 不可用时回退 veth
CONFIG_PACKAGE_kmod-veth=y

# ---- 3. dae 本体 + 地理数据 + LuCI ----
# ⚠️ 上游 QiuSimons/luci-app-dae 已把包结构合并：dae 现在是【单包】，
#    原来的 dae-geoip / dae-geosite 子包已删除，改为直接 DEPENDS v2ray-geoip/geosite。
#    所以这里**不能**再写 CONFIG_PACKAGE_dae-geoip（该符号已不存在）。
CONFIG_PACKAGE_dae=y
# dae 的 DEPENDS 会拉这两个，但显式写出来，避免 defconfig 求解顺序造成意外
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
CONFIG_PACKAGE_luci-app-dae=y
# luci-app-dae 仍是 Lua 版 LuCI（luasrc/），luci.mk 会为它自动加 +luci-lua-runtime；
# 它自身 DEPENDS 里还有 +luci-compat，显式打开避免 lua 视图加载失败
CONFIG_PACKAGE_luci-compat=y
# LuCI 中文翻译由 luci.mk 从 po/ 自动生成独立包，要显式选才会进镜像
CONFIG_PACKAGE_luci-i18n-dae-zh-cn=y

# ---- 3b. BTF 来源必须选"用内核自带 BTF"----
# package/dae/Makefile 里有个 choice：
#   DAE_USE_KERNEL_BTF   （默认）→ 用内核 /sys/kernel/btf/vmlinux
#   DAE_USE_VMLINUX_BTF  → 依赖虚包 vmlinux-btf（ponwrt 主树里【没有】这个包）
# 我们已经在核心层开了 DEBUG_INFO_BTF，所以必须锁内核 BTF 这条路。
CONFIG_DAE_USE_KERNEL_BTF=y
# CONFIG_DAE_USE_VMLINUX_BTF is not set

# ---- 4. 明确排除其它代理栈（"只保留一种"）----
# 与 Passwall / OpenClash 互斥：同时装会多出 100MB+ 的进程与依赖
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-openclash is not set
# 上游 an7581.config 把 passwall 的一堆 INCLUDE_* 设成了 y。虽然 passwall 本体已关，
# 这些子符号不会真的拉包，但留着会让 defconfig 的求解过程更绕，一并清掉。
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geoview is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray is not set
# dae 不需要这些内核；留着只占体积（且 Passwall 的 xray 会与 dae 抢 TPROXY 端口）
# CONFIG_PACKAGE_xray-core is not set
# CONFIG_PACKAGE_sing-box is not set
# CONFIG_PACKAGE_sing-box-tiny is not set
# CONFIG_PACKAGE_hysteria is not set
# CONFIG_PACKAGE_chinadns-ng is not set
# CONFIG_PACKAGE_dns2tcp is not set
# CONFIG_PACKAGE_shadowsocks-rust-sslocal is not set
# CONFIG_PACKAGE_shadowsocks-rust-ssserver is not set
# CONFIG_PACKAGE_v2ray-core is not set
# CONFIG_PACKAGE_v2ray-plugin is not set
# CONFIG_PACKAGE_trojan is not set
# CONFIG_PACKAGE_naiveproxy is not set
# CONFIG_PACKAGE_microsocks is not set
# CONFIG_PACKAGE_3proxy is not set
# CONFIG_PACKAGE_brook is not set
# CONFIG_PACKAGE_tuic-client is not set
