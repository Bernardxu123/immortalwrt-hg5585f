# ---------------------------------------------------------------------------
# HG5585F 专用构建层（kconfig.pl 链式的最后一步，优先级最高）
#
# 设计原则（2026-10-17 与用户确认）：
#   角色 = 桥接默认 + 保留完整路由能力
#     → firewall4 / dnsmasq-full / ppp 全留，随时能改配置顶替主路由拨号
#   身份数据不预置（LOID / PON SN / MAC 刷完在 LuCI 填）
# ---------------------------------------------------------------------------

# ---- 构建加速 ----
# 二次构建（改 overlay / 改包）可从 ~3h 降到 ~1h
CONFIG_CCACHE=y
# 具体路径由 scripts/hg5585f/gen-config.sh 在 defconfig 之后用绝对路径注入

# ---- 镜像形态 ----
# INITRAMFS 保留：产出 *-recovery.itb，刷砖时是 U-Boot 唯一的软着陆
# （若 CI 撞 350 分钟超时，这是第一个该关的开关）
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_CPIOGZ is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_EROFS is not set
# CONFIG_TARGET_ROOTFS_PERSIST_VAR is not set

# ---- 桥接快路径：保留 conntrack-bridge，改为开启桥接 flow offload ----
# 排查记录（2026-10-17）：最初打算删掉 kmod-nf-conntrack-bridge 以求"桥接零开销"，
# 读源码后推翻了这个判断，理由是：
#   1) 它只 DEPENDS +kmod-nf-conntrack，**不拉 br_netfilter**（br_netfilter 是独立包
#      kmod-br-netfilter，我们没装）→ 删它并不能"避免桥接帧进 netfilter"
#   2) 它装的是 nf_conntrack_bridge.ko（桥接帧走 conntrack）
#   3) ponwrt 给 fw4 打了 package/network/config/firewall4/patches/
#      001-add-bridge-flowtable-support.patch，**专门为"防火墙 zone 之外的透明网桥"
#      生成 bridge-family flowtable（table bridge fw4 / flowtable fb），并显式把
#      VLAN 桥端口解析到物理 lower device** —— 这正是我们的拓扑（br-lan 含 pon0.995）
#   4) 该 flowtable 依赖 bridge conntrack；删掉 conntrack-bridge 等于**把唯一能
#      让 AN7581 PPE/L2B 卸载桥接流量的通路砍掉**
# 所以：保留 conntrack-bridge，真正的优化动作是 uci-defaults 里开
#   firewall.@defaults[0].flow_offloading=1 + flow_offloading_hw=1
CONFIG_PACKAGE_kmod-nf-conntrack-bridge=y
CONFIG_PACKAGE_kmod-nf-flow=y
CONFIG_PACKAGE_kmod-nft-bridge=y

# ---- 能力锚点（上游本来就是 y，这里显式 pin，防上游 config 漂移）----
# 路由能力（切 PPPoE 顶替主路由时必需）
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_kmod-sched-cake=y
CONFIG_PACKAGE_kmod-tcp-bbr=y

# PON 栈（少一个都起不来）
CONFIG_PACKAGE_kmod-airoha-xpon=y
CONFIG_PACKAGE_kmod-airoha-en7572=y
CONFIG_PACKAGE_kmod-airoha-paged-bosa=y
CONFIG_PACKAGE_airoha-ponctl=y
CONFIG_PACKAGE_airoha-pond=y
CONFIG_PACKAGE_luci-app-pon=y

# WiFi 硬件保留（默认在 uci-defaults 里关闭 radio，随时一行打开）
# wpad-openssl 不在此 pin：Device/fiberhome_hg5585f-common 的 DEVICE_PACKAGES 已经带上它，
# 这里再写 =m 反而会把它从镜像里摘掉，导致"一行打开 WiFi"失效。
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7916-firmware=y

# 运维工具
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_nand-utils=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_fitblk=y
CONFIG_PACKAGE_tcpdump=y
