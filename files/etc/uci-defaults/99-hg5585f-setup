#!/bin/sh
# /etc/uci-defaults/99-hg5585f-setup
#
# 首次启动执行一次（uci-defaults 机制会在脚本返回 0 后删除本文件）。
# 执行时机：/etc/init.d/boot (START=10) → uci_apply_defaults
#           → 早于 /etc/init.d/network (START=20)，所以改完 netifd 才起来。
#
# 执行顺序前提：
#   1. /lib/preinit/82_config_generate 已经在 preinit 阶段用 board.json 生成了
#      network（br-lan 含 lan1..lan4，wan=pon0/proto=dhcp）和 system。
#   2. /etc/uci-defaults/15_odhcpd 已经在 15 号跑过；因为我们的
#      /etc/config/dhcp 里带了 config odhcpd 段，它会直接 exit，不会强开 DHCP server。
#
# 本脚本做的事：把"通用 OpenWrt 默认"改造成"HG5585F 桥接 + 联通 10G-EPON"。
# 身份数据（LOID / SN / MAC）不在这里写，刷完在 LuCI 里填。

LOG=/tmp/hg5585f-setup.log
: > "$LOG"
log() {
	echo "$*" >> "$LOG"
	logger -t hg5585f-setup "$*"
}

VLAN_INTERNET=995      # 原厂 veip0_995_wan_conf：INTERNET / VLAN 995 / bridge
LAN_ADDR=192.168.1.1   # 与现役一致，主路由 wan 侧挂 192.168.1.2/24 即可管理

# ---------------------------------------------------------------------------
# 1. 重建 network.device：br-lan = lan1..4 + pon0.995
#
# config_generate 生成的是匿名 device 段（network.@device[N]），无法稳定寻址。
# 全部删掉，改用命名段重建，后续维护/对比都直观。
# ---------------------------------------------------------------------------
n=$(uci -q show network 2>/dev/null | grep -c '=device$')
while [ "$n" -gt 0 ]; do
	uci -q delete network.@device[0]
	n=$((n - 1))
done

uci -q delete network.br_lan
uci -q delete network.pon0_995

uci -q batch <<EOF
set network.br_lan='device'
set network.br_lan.name='br-lan'
set network.br_lan.type='bridge'
add_list network.br_lan.ports='lan1'
add_list network.br_lan.ports='lan2'
add_list network.br_lan.ports='lan3'
add_list network.br_lan.ports='lan4'
add_list network.br_lan.ports='pon0.995'

set network.pon0_995='device'
set network.pon0_995.name='pon0.995'
set network.pon0_995.type='8021q'
set network.pon0_995.ifname='pon0'
set network.pon0_995.vid='${VLAN_INTERNET}'
EOF

# ---------------------------------------------------------------------------
# 2. lan：静态管理地址，不带网关/DNS，IPv6 全关
#    没有网关 = 本机不会尝试把管理流量路由出去，也不会和主路由抢默认路由。
# ---------------------------------------------------------------------------
uci -q batch <<EOF
set network.lan='interface'
set network.lan.device='br-lan'
set network.lan.proto='static'
set network.lan.ipaddr='${LAN_ADDR}'
set network.lan.netmask='255.255.255.0'
set network.lan.peerdns='0'
set network.lan.delegate='0'
set network.lan.ipv6='0'
delete network.lan.gateway
delete network.lan.dns
delete network.lan.ip6assign
delete network.lan.ip6hint
delete network.lan.ip6ifaceid
delete network.lan.ip6class
delete network.lan.ip6prefix
delete network.lan.ifname
EOF

# ---------------------------------------------------------------------------
# 3. wan：保留接口但不上协议
#    为什么保留而不是删掉：
#      a) pon0 必须被 netifd 打开（proto none 也会 ip link set up），
#         pon0 不 up 则 pon0.995 这个 8021q 子设备无法转发；
#      b) 将来要切路由模式（光猫自己 PPPoE 顶替主路由），只需改一行
#         uci set network.wan.proto='pppoe'，不用重建接口。
# ---------------------------------------------------------------------------
uci -q batch <<EOF
set network.wan='interface'
set network.wan.device='pon0'
set network.wan.proto='none'
set network.wan.auto='1'
set network.wan.ipv6='0'
delete network.wan.username
delete network.wan.password
delete network.wan.hostname
delete network.wan.metric
delete network.wan6
delete network.wan6t
EOF

# ---------------------------------------------------------------------------
# 4. 桥接 flow offload —— 本机型真正的性能优化点
#
# ponwrt 给 fw4 打了 001-add-bridge-flowtable-support.patch，会为
# "防火墙 zone 之外的透明网桥"生成 table bridge fw4 / flowtable fb，
# 并把 VLAN 桥端口（pon0.995）解析到物理 lower device（pon0）交给硬件卸载。
# 这条通路需要：
#   - kmod-nf-conntrack-bridge（已在 configs/hg5585f-build.config 里 pin 住）
#   - firewall.@defaults[0].flow_offloading = 1
#   - flow_offloading_hw = 1 才会带 flags offload（AN7581 PPE/L2B 硬件卸载）
#
# 若实测发现桥接吞吐反而下降（硬件卸载路径异常），先关 hw 只留软件 flowtable：
#   uci set firewall.@defaults[0].flow_offloading_hw='0'
# ---------------------------------------------------------------------------
uci -q batch <<EOF
set firewall.@defaults[0].flow_offloading='1'
set firewall.@defaults[0].flow_offloading_hw='1'
EOF

# ---------------------------------------------------------------------------
# 5. WiFi 默认关闭
#
# 不只是 SSID 冲突：WiFi 桥进 br-lan 等于把无线客户端直接接到运营商二层域，
# 客户端的 DHCP 广播会顺着 pon0.995 出去，事故面比有线更大。
# 包和驱动都保留，需要时一行打开：
#   uci set wireless.radio0.disabled='0'; uci set wireless.radio1.disabled='0'
#   uci commit wireless; wifi up
# ---------------------------------------------------------------------------
if [ -x /sbin/wifi ]; then
	/sbin/wifi config >/dev/null 2>&1
	for r in $(uci -q show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.=]*\)=wifi-device$/\1/p"); do
		uci -q set "wireless.$r.disabled='1'"
	done
	uci -q commit wireless
fi

# ---------------------------------------------------------------------------
# 6. 时间同步与时区
#    桥接模式下本机没有外网出口，NTP 只有在切路由模式后才真正生效，
#    但配置先备好，避免将来切模式时再翻一遍。
# ---------------------------------------------------------------------------
uci -q batch <<EOF
set system.@system[0].timezone='CST-8'
set system.@system[0].zonename='Asia/Shanghai'
set system.ntp='timeserver'
set system.ntp.enabled='1'
set system.ntp.enable_server='0'
delete system.ntp.server
add_list system.ntp.server='ntp.aliyun.com'
add_list system.ntp.server='ntp.tencent.com'
add_list system.ntp.server='cn.pool.ntp.org'
EOF

uci -q commit network
uci -q commit firewall
uci -q commit system

# ---------------------------------------------------------------------------
# 7. DHCP 安全兜底（第三重保险）
#
# /etc/config/dhcp 已经带 ignore=1，这里再强制一次并校验。
# 之所以这么小心：br-lan 桥到 pon0.995，DHCP 报文会直接进联通接入网。
# ---------------------------------------------------------------------------
uci -q set dhcp.lan.ignore='1'
uci -q set dhcp.lan.dhcpv4='disabled'
uci -q set dhcp.lan.dhcpv6='disabled'
uci -q set dhcp.lan.ra='disabled'
uci -q set dhcp.lan.ndp='disabled'
uci -q commit dhcp

if [ "$(uci -q get dhcp.lan.ignore)" != "1" ]; then
	log "ERROR: dhcp.lan.ignore 未能设为 1，禁用 dnsmasq 兜底"
	/etc/init.d/dnsmasq disable 2>/dev/null
else
	log "OK: dhcp.lan.ignore=1（不会向 PON 侧发 DHCP）"
fi

# ---------------------------------------------------------------------------
# 8. 自检：把结果写进日志，方便刷完第一时间确认
# ---------------------------------------------------------------------------
if uci -q get network.br_lan.ports | grep -qw 'pon0.995'; then
	log "OK: br-lan 成员 = $(uci -q get network.br_lan.ports | tr '\n' ' ')"
else
	log "ERROR: br-lan 成员里没有 pon0.995，桥接不会通"
fi

log "OK: pon mode=$(uci -q get pon.line0.mode) operator=$(uci -q get pon.line0_oam.operator) ge_ports=$(uci -q get pon.line0_oam.ge_ports)"
log "OK: flow_offloading=$(uci -q get firewall.@defaults[0].flow_offloading) hw=$(uci -q get firewall.@defaults[0].flow_offloading_hw)"
log "待办：填 LOID / 上传 PON board data（见 /etc/motd）"

exit 0
